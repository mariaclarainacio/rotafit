{
  "expo": {
    "name": "RotaFit",
    "slug": "rotafit",
    "scheme": "rotafit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O RotaFit usa sua localização para registrar a rota e o ritmo da corrida."
        }
      ],
      "expo-font"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "mariaclara.rotafit",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "O RotaFit usa sua localização para registrar a rota da corrida."
      }
    },
    "android": {
      "package": "mariaclara.rotafit",
      "adaptiveIcon": {
        "backgroundColor": "#B81104",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    }
  }
}
